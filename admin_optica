<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>ERP Óptica Visión HD | Control Administrativo, Ventas, Clínica y Contabilidad</title>
  <style>
    :root {
      --primary: #0f294a;
      --primary-light: #1e4273;
      --accent: #008080;
      --accent-light: #e6fffa;
      --success: #16a34a;
      --warning: #d97706;
      --danger: #dc2626;
      --bg: #f1f5f9;
      --card: #ffffff;
      --text: #1e293b;
      --muted: #64748b;
      --border: #e2e8f0;
      --shadow: 0 4px 12px rgba(15, 41, 74, 0.06);
      --radius: 10px;
    }

    * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif; }
    body { background-color: var(--bg); color: var(--text); display: flex; min-height: 100vh; }

    .sidebar { width: 265px; background: var(--primary); color: #fff; display: flex; flex-direction: column; flex-shrink: 0; }
    .sidebar-brand { padding: 20px; font-size: 1.25rem; font-weight: 800; border-bottom: 1px solid rgba(255,255,255,0.1); display: flex; align-items: center; gap: 10px; }
    .sidebar-brand span { color: #38bdf8; }

    .store-link-box { padding: 12px 20px; background: rgba(0,128,128,0.28); border-bottom: 1px solid rgba(255,255,255,0.1); }
    .store-link-box a {
      display: block; text-align: center; background: #008080; color: #fff; text-decoration: none;
      padding: 8px 12px; border-radius: 6px; font-weight: 700; font-size: 0.85rem;
    }
    .store-link-box a:hover { background: #006666; }

    .user-role-box { padding: 14px 20px; background: rgba(0,0,0,0.2); border-bottom: 1px solid rgba(255,255,255,0.1); font-size: 0.85rem; }
    .user-role-box select { width: 100%; margin-top: 6px; padding: 6px; border-radius: 6px; border: none; font-weight: 600; background: #fff; color: var(--primary); }

    .nav-menu { list-style: none; padding: 14px 0; flex: 1; }
    .nav-item {
      padding: 12px 20px; cursor: pointer; display: flex; align-items: center; justify-content: space-between;
      font-size: 0.91rem; color: #cbd5e1; transition: all 0.2s; border-left: 4px solid transparent;
    }
    .nav-item:hover, .nav-item.active { background: var(--primary-light); color: #fff; border-left-color: #38bdf8; font-weight: 600; }
    .nav-badge { background: #ef4444; color: #fff; font-size: 0.72rem; padding: 2px 7px; border-radius: 10px; font-weight: 800; }

    .sidebar-footer { padding: 14px 20px; font-size: 0.78rem; color: #94a3b8; border-top: 1px solid rgba(255,255,255,0.1); }

    .main-wrapper { flex: 1; display: flex; flex-direction: column; overflow-x: hidden; }
    .topbar { background: #fff; padding: 14px 24px; box-shadow: var(--shadow); display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 12px; z-index: 10; }
    .topbar-title { font-size: 1.18rem; font-weight: 700; color: var(--primary); }
    .topbar-controls { display: flex; align-items: center; gap: 12px; flex-wrap: wrap; }

    .rate-pill {
      background: var(--accent-light); color: var(--accent); padding: 6px 12px; border-radius: 20px;
      font-size: 0.85rem; font-weight: 700; display: flex; align-items: center; gap: 6px; border: 1px solid #99f6e4;
    }
    .rate-pill input { width: 65px; padding: 2px 6px; border: 1px solid #cbd5e1; border-radius: 4px; font-weight: 700; text-align: right; }

    .content-area { padding: 24px; max-width: 1440px; width: 100%; margin: 0 auto; }
    .module-section { display: none; }
    .module-section.active { display: block; }

    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 18px; margin-bottom: 24px; }
    .kpi-card { background: var(--card); padding: 18px; border-radius: var(--radius); box-shadow: var(--shadow); border-left: 4px solid var(--primary); }
    .kpi-card.accent { border-left-color: var(--accent); }
    .kpi-card.success { border-left-color: var(--success); }
    .kpi-card.warning { border-left-color: var(--warning); }
    .kpi-label { font-size: 0.82rem; color: var(--muted); font-weight: 600; text-transform: uppercase; }
    .kpi-value { font-size: 1.65rem; font-weight: 800; color: var(--text); margin: 6px 0; }
    .kpi-sub { font-size: 0.8rem; color: var(--muted); }

    .panel { background: var(--card); border-radius: var(--radius); box-shadow: var(--shadow); padding: 20px; margin-bottom: 24px; }
    .panel-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 16px; padding-bottom: 10px; border-bottom: 1px solid var(--border); flex-wrap: wrap; gap: 10px; }
    .panel-header h3 { color: var(--primary); font-size: 1.05rem; }

    .form-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(190px, 1fr)); gap: 12px; margin-bottom: 16px; }
    .form-group { display: flex; flex-direction: column; gap: 4px; }
    .form-group label { font-size: 0.78rem; font-weight: 700; color: var(--muted); }
    .form-group input, .form-group select { padding: 8px 10px; border: 1px solid var(--border); border-radius: 6px; font-size: 0.88rem; background: #fff; }

    .btn { padding: 8px 14px; border: none; border-radius: 6px; font-weight: 600; font-size: 0.85rem; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; }
    .btn:hover { opacity: 0.9; }
    .btn-primary { background: var(--primary); color: #fff; }
    .btn-accent { background: var(--accent); color: #fff; }
    .btn-success { background: var(--success); color: #fff; }
    .btn-danger { background: var(--danger); color: #fff; }
    .btn-outline { background: #fff; border: 1px solid var(--border); color: var(--text); }

    .table-responsive { overflow-x: auto; }
    table { width: 100%; border-collapse: collapse; font-size: 0.86rem; }
    th { background: #f8fafc; color: var(--primary); font-weight: 700; text-align: left; padding: 11px 12px; border-bottom: 2px solid var(--border); white-space: nowrap; }
    td { padding: 10px 12px; border-bottom: 1px solid var(--border); vertical-align: middle; }
    tr:hover td { background: #f8fafc; }

    .badge { padding: 3px 8px; border-radius: 12px; font-size: 0.74rem; font-weight: 700; display: inline-block; }
    .badge-green { background: #dcfce7; color: #166534; }
    .badge-blue { background: #dbeafe; color: #1e40af; }
    .badge-amber { background: #fef3c7; color: #92400e; }
    .badge-red { background: #fee2e2; color: #991b1b; }
    .badge-purple { background: #f3e8ff; color: #6b21a8; }

    .rx-mini-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 14px; background: #f8fafc; padding: 14px; border-radius: 8px; border: 1px solid var(--border); margin-bottom: 14px; }
    .rx-eye-box h4 { font-size: 0.85rem; color: var(--primary); margin-bottom: 8px; }
    .rx-inputs { display: grid; grid-template-columns: repeat(5, 1fr); gap: 6px; }
    .rx-inputs input { width: 100%; padding: 6px; border: 1px solid var(--border); border-radius: 4px; font-size: 0.82rem; }

    .info-banner { background: #eff6ff; border: 1px solid #bfdbfe; color: #1e3a8a; padding: 12px 16px; border-radius: 8px; font-size: 0.88rem; margin-bottom: 18px; }

    @media (max-width: 850px) {
      body { flex-direction: column; }
      .sidebar { width: 100%; }
      .nav-menu { display: flex; overflow-x: auto; padding: 6px; }
      .nav-item { white-space: nowrap; border-left: none; border-bottom: 3px solid transparent; }
      .nav-item.active { border-bottom-color: #38bdf8; }
    }
  </style>
</head>
<body>

  <aside class="sidebar">
    <div class="sidebar-brand">🏛️ ERP <span>ÓPTICA HD</span></div>

    <div class="store-link-box">
      <a href="index.html" target="_blank">👓 Abrir Tienda Web (index.html) ↗</a>
    </div>

    <div class="user-role-box">
      <label>Sesión Activa (Rol de Usuario):</label>
      <select id="activeUserRole" onchange="applyRolePermissions()">
        <option value="Administrador">👑 Administrador General</option>
        <option value="Optometrista">🩺 Optometrista / Especialista</option>
        <option value="Asesor_Ventas">💼 Asesor de Ventas / Caja</option>
        <option value="Taller_Lab">⚙️ Jefe de Taller / Laboratorio</option>
        <option value="Contador">📊 Contador / Administración</option>
      </select>
    </div>

    <ul class="nav-menu">
      <li class="nav-item active" onclick="switchModule('dashboard', this)"><span>📊 Dashboard y Contabilidad</span></li>
      <li class="nav-item" onclick="switchModule('weborders', this)">
        <span>🌐 Pedidos Recibidos Web</span>
        <span class="nav-badge" id="webOrdersBadge">0</span>
      </li>
      <li class="nav-item" onclick="switchModule('inventario', this)"><span>📦 Inventario Sincronizado</span></li>
      <li class="nav-item" onclick="switchModule('ventas', this)"><span>🧾 Ventas y Productos Vendidos</span></li>
      <li class="nav-item" onclick="switchModule('pacientes', this)"><span>🩺 Ficha Clínica de Pacientes</span></li>
      <li class="nav-item" onclick="switchModule('clientes', this)"><span>👥 Clientes y Facturación</span></li>
      <li class="nav-item" onclick="switchModule('staff', this)"><span>👨‍⚕️ Médicos, Especialistas y Staff</span></li>
      <li class="nav-item" onclick="switchModule('usuarios', this)"><span>🔐 Usuarios y Permisos</span></li>
    </ul>

    <div class="sidebar-footer">
      <div>Enlazado con index.html</div>
      <div>Sync: localStorage + Respaldo JSON</div>
    </div>
  </aside>

  <div class="main-wrapper">
    <header class="topbar">
      <div class="topbar-title" id="moduleTitle">Dashboard Administrativo y Control Contable</div>
      <div class="topbar-controls">
        <div class="rate-pill">
          <span>Tasa Sincronizada:</span>
          <input type="number" id="bcvRate" value="45.50" step="0.10" onchange="syncRateFromAdmin()" />
          <span>Bs./USD</span>
        </div>
        <button class="btn btn-outline" onclick="exportAllJSON()">⬇️ Descargar Respaldo (.json)</button>
        <label class="btn btn-outline" style="cursor:pointer;">
          ⬆️ Restaurar (.json)
          <input type="file" accept=".json" style="display:none;" onchange="importAllJSON(event)" />
        </label>
      </div>
    </header>

    <div class="content-area">

      <!-- =================================================================== -->
      <!-- MÓDULO 1: DASHBOARD Y CONTROL CONTABLE                              -->
      <!-- =================================================================== -->
      <section id="mod-dashboard" class="module-section active">
        <div class="kpi-grid">
          <div class="kpi-card success">
            <div class="kpi-label">Ingresos Brutos (Ventas)</div>
            <div class="kpi-value" id="kpiSalesUsd">$0.00</div>
            <div class="kpi-sub" id="kpiSalesBs">0.00 Bs.</div>
          </div>
          <div class="kpi-card warning">
            <div class="kpi-label">Costo de Mercancía Vendida</div>
            <div class="kpi-value" id="kpiCostUsd">$0.00</div>
            <div class="kpi-sub">Costo directo de monturas y lunas</div>
          </div>
          <div class="kpi-card accent">
            <div class="kpi-label">Utilidad Neta Estimada</div>
            <div class="kpi-value" id="kpiProfitUsd">$0.00</div>
            <div class="kpi-sub" id="kpiMarginPct">Margen: 0%</div>
          </div>
          <div class="kpi-card">
            <div class="kpi-label">Pedidos Web Pendientes</div>
            <div class="kpi-value" id="kpiWebPending">0</div>
            <div class="kpi-sub" id="kpiPatientsCount">0 fichas clínicas activas</div>
          </div>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h3>📒 Libro Contable de Operaciones (Ingresos, Egresos y Métodos de Pago)</h3>
            <button class="btn btn-accent" onclick="exportTableCSV('tablaContable', 'Libro_Contable_Optica.csv')">Exportar CSV / Excel</button>
          </div>

          <div class="form-grid">
            <div class="form-group">
              <label>Tipo Movimiento</label>
              <select id="accType">
                <option value="Ingreso">Ingreso (Venta / Consulta)</option>
                <option value="Egreso">Egreso (Pago Laboratorio / Gasto)</option>
              </select>
            </div>
            <div class="form-group">
              <label>Concepto / Descripción</label>
              <input type="text" id="accDesc" placeholder="Ej: Pago a Laboratorio Tallado o Venta #004" />
            </div>
            <div class="form-group">
              <label>Método de Pago</label>
              <select id="accMethod">
                <option value="Divisas Efectivo ($)">Divisas Efectivo ($)</option>
                <option value="Zelle / Transferencia USD">Zelle / Transferencia USD</option>
                <option value="Pago Móvil / Punto Bs.">Pago Móvil / Punto Bs.</option>
                <option value="Cashea / Financiamiento">Cashea / Financiamiento</option>
              </select>
            </div>
            <div class="form-group">
              <label>Monto (USD)</label>
              <input type="number" id="accAmount" step="0.01" placeholder="0.00" />
            </div>
            <div class="form-group" style="justify-content: flex-end;">
              <button class="btn btn-primary" onclick="addAccountingEntry()">+ Registrar Asiento</button>
            </div>
          </div>

          <div class="table-responsive">
            <table id="tablaContable">
              <thead>
                <tr>
                  <th>Fecha</th>
                  <th>Tipo</th>
                  <th>Concepto</th>
                  <th>Método Pago</th>
                  <th>Monto USD</th>
                  <th>Equivalente Bs.</th>
                </tr>
              </thead>
              <tbody id="accTableBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- MÓDULO NUEVO: PEDIDOS WEB RECIBIDOS DESDE index.html                -->
      <!-- =================================================================== -->
      <section id="mod-weborders" class="module-section">
        <div class="info-banner">
          🔗 <strong>Conexión directa con la tienda (index.html):</strong> Cada vez que un cliente arma su carrito en la página pública y presiona <em>"Enviar Pedido a WhatsApp"</em>, el pedido aparece aquí automáticamente. Al hacer clic en <strong>Aprobar y Facturar</strong>, se descuenta el stock de la tienda, se registra el cliente, se crea la ficha si incluye fórmula y se contabiliza la venta.
        </div>

        <div class="panel">
          <div class="panel-header">
            <h3>🌐 Bandeja de Pedidos Online (Desde index.html)</h3>
            <button class="btn btn-outline" onclick="refreshAll()">🔄 Actualizar Bandeja</button>
          </div>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>Código Web</th>
                  <th>Fecha</th>
                  <th>Cliente / Teléfono</th>
                  <th>Modalidad</th>
                  <th>Productos / Fórmula</th>
                  <th>Total USD</th>
                  <th>Estado</th>
                  <th>Acción ERP</th>
                </tr>
              </thead>
              <tbody id="webOrdersTableBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- MÓDULO NUEVO: INVENTARIO SINCRONIZADO CON LA TIENDA PÚBLICA         -->
      <!-- =================================================================== -->
      <section id="mod-inventario" class="module-section">
        <div class="info-banner">
          📦 <strong>Inventario Maestro Compartido:</strong> Cualquier cambio de precio, stock o producto nuevo que agregues aquí se actualiza inmediatamente en el catálogo público de <code>index.html</code>.
        </div>

        <div class="panel">
          <div class="panel-header">
            <h3>➕ Agregar Producto al Catálogo Público y Almacén</h3>
          </div>
          <div class="form-grid">
            <div class="form-group"><label>SKU *</label><input type="text" id="invSku" placeholder="Ej: MON-PRADA-05" /></div>
            <div class="form-group">
              <label>Departamento</label>
              <select id="invDept">
                <option value="Monturas">Monturas</option>
                <option value="Cristales">Cristales</option>
                <option value="Contactologia">Contactología</option>
                <option value="Accesorios">Accesorios</option>
                <option value="Servicios">Servicios</option>
              </select>
            </div>
            <div class="form-group"><label>Marca *</label><input type="text" id="invBrand" placeholder="Ej: Prada / Ray-Ban" /></div>
            <div class="form-group"><label>Nombre / Modelo *</label><input type="text" id="invName" placeholder="Ej: PR 17WS Carey" /></div>
            <div class="form-group"><label>Subtipo</label><input type="text" id="invSub" placeholder="Ej: Oftálmico / Sol / Monofocal" /></div>
            <div class="form-group">
              <label>Género</label>
              <select id="invGender">
                <option value="Unisex">Unisex</option>
                <option value="Mujer">Mujer</option>
                <option value="Hombre">Hombre</option>
                <option value="Infantil">Infantil</option>
              </select>
            </div>
            <div class="form-group">
              <label>Edad</label>
              <select id="invAge">
                <option value="Adultos">Adultos</option>
                <option value="Jóvenes">Jóvenes</option>
                <option value="Niños">Niños</option>
              </select>
            </div>
            <div class="form-group"><label>Material / Spec</label><input type="text" id="invMat" placeholder="Ej: Acetato Italiano" /></div>
            <div class="form-group"><label>Medidas</label><input type="text" id="invMeas" placeholder="Ej: 52-18-140 mm" /></div>
            <div class="form-group"><label>Stock Inicial</label><input type="number" id="invStock" value="10" /></div>
            <div class="form-group"><label>Costo USD</label><input type="number" id="invCost" step="0.01" value="50.00" /></div>
            <div class="form-group"><label>Precio Venta USD</label><input type="number" id="invPrice" step="0.01" value="120.00" /></div>
          </div>
          <button class="btn btn-primary" onclick="addCatalogItem()">💾 Guardar y Publicar en Tienda</button>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h3>📋 Control de Stock y Precios Publicados</h3>
          </div>
          <div class="table-responsive">
            <table>
              <thead>
                <tr>
                  <th>SKU</th>
                  <th>Depto.</th>
                  <th>Marca / Modelo</th>
                  <th>Público</th>
                  <th>Costo USD</th>
                  <th>Precio Venta USD</th>
                  <th>Stock Actual</th>
                  <th>Ajuste Rápido</th>
                </tr>
              </thead>
              <tbody id="inventoryTableBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- MÓDULO: CONTROL DE PRODUCTOS VENDIDOS                               -->
      <!-- =================================================================== -->
      <section id="mod-ventas" class="module-section">
        <div class="panel">
          <div class="panel-header">
            <h3>🧾 Registrar Venta Directa en Tienda / Orden de Trabajo</h3>
          </div>
          <div class="form-grid">
            <div class="form-group"><label>Cliente / Paciente</label><input type="text" id="saleClient" placeholder="Nombre del comprador" /></div>
            <div class="form-group"><label>Producto del Catálogo</label><select id="saleProductSelect" onchange="fillSalePriceFromCatalog()"></select></div>
            <div class="form-group"><label>Cantidad</label><input type="number" id="saleQty" value="1" min="1" /></div>
            <div class="form-group"><label>Precio Unit. USD</label><input type="number" id="salePrice" step="0.01" /></div>
            <div class="form-group">
              <label>Especialista / Vendedor</label>
              <select id="saleSeller">
                <option value="Dra. Valeria Mendoza (Optometrista)">Dra. Valeria Mendoza</option>
                <option value="Carlos Rivas (Asesor Ventas)">Carlos Rivas</option>
                <option value="Dr. Andrés Silva (Oftalmólogo)">Dr. Andrés Silva</option>
              </select>
            </div>
            <div class="form-group">
              <label>Estado de Orden / Taller</label>
              <select id="saleStatus">
                <option value="Entregado">Entregado</option>
                <option value="En Laboratorio / Biselado">En Laboratorio / Biselado</option>
                <option value="Listo para Retiro">Listo para Retiro</option>
              </select>
            </div>
          </div>
          <button class="btn btn-success" onclick="registerDirectSale()">✅ Registrar Venta y Descontar Stock</button>
        </div>

        <div class="panel">
          <div class="panel-header">
            <h3>📦 Historial de Productos Vendidos y Control de Márgenes</h3>
            <button class="btn btn-accent" onclick="exportTableCSV('tablaVentas', 'Productos_Vendidos_Optica.csv')">Exportar CSV</button>
          </div>
          <div class="table-responsive">
            <table id="tablaVentas">
              <thead>
                <tr>
                  <th>N° Orden</th>
                  <th>Fecha</th>
                  <th>Cliente</th>
                  <th>SKU</th>
                  <th>Producto / Detalle</th>
                  <th>Cant.</th>
                  <th>Total Venta</th>
                  <th>Costo</th>
                  <th>Utilidad</th>
                  <th>Responsable</th>
                  <th>Estado</th>
                </tr>
              </thead>
              <tbody id="salesTableBody"></tbody>
            </table>
          </div>
        </div>
      </section>

      <!-- =================================================================== -->
      <!-- MÓDULO: FICHA CLÍNICA DE PACIENTES                                  -->
      <!-- =================================================================== -->
      <section id="mod-pacientes" class="module-section">
        <div class="panel">
          <div class="panel-header">
            <h3>🩺 Nueva Ficha Clínica e Historia Optométrica</h3>
          </div>
          <div class="form-grid">
            <div class="form-group"><label>Nombre Completo *</label><input type="text" id="patName" placeholder="Ej: María Fernanda Gómez" /></div>
            <div class="form-group"><label>Cédula / ID *</label><input type="text" id="patId" placeholder="Ej: V-18.456.789" /></div>
            <div class="form-group"><label>Edad</label><input type="number" id="patAge" placeholder="Ej: 34" /></div>
            <div class="form-group"><label>Teléfono</label><input type="text" id="patPhone" placeholder="Ej: 0414-1234567" /></div>
            <div class="form-group">
              <label>Especialista</label>
              <select id="patDoctor">
                <option value="Dra. Valeria Mendoza (Optometrista)">Dra. Valeria Mendoza (Optometrista)</option>
                <option value="Dr. Andrés Silva (Oftalmólogo)">Dr. Andrés Silva (Oftalmólogo)</option>
              </select>
            </div>
            <div class="form-group"><label>Diagnóstico Visual</label><input type="text" id="patDiag" placeholder="Ej: Astigmatismo Miópico + Presbicia" /></div>
          </div>

          <div class="rx-mini-grid">
            <div class="rx-eye-box">
              <h4>Ojo Derecho (OD)</h4>
              <div class="rx-inputs">
