    function approveWebOrder(webOrderCode) {
      const webOrders = JSON.parse(localStorage.getItem("optica_web_orders")) || [];
      const order = webOrders.find(o => o.webOrderCode === webOrderCode);
      if (!order || order.status !== "Pendiente por Procesar") return;

      const catalog = getCatalog();
      const today = new Date().toISOString().slice(0, 10);

      order.items.forEach((item, idx) => {
        const orderId = `${order.webOrderCode}-${idx + 1}`;
        const saleUsd = item.precio_usd * item.qty;
        const costUsd = (item.costo_usd || 0) * item.qty;

        salesData.unshift({
          orderId,
          date: today,
          client: order.customer.name,
          sku: item.sku,
          product: item.nombre,
          qty: item.qty,
          saleUsd,
          costUsd,
          seller: "Tienda Web (index.html)",
          status: item.rx_od ? "En Laboratorio / Biselado" : "Listo para Retiro"
        });

        // Descontar stock en catálogo compartido
        const catItem = catalog.find(c => c.sku === item.sku);
        if (catItem && catItem.stock > 0) {
          catItem.stock = Math.max(0, catItem.stock - item.qty);
        }

        // Si el pedido web traía fórmula médica, crear ficha clínica automáticamente
        if (item.rx_od) {
          patientsData.unshift({
            hc: "HC-00" + (patientsData.length + 1),
            name: order.customer.name,
            idDoc: order.customer.cedula,
            age: "Web",
            od: item.rx_od,
            oi: item.rx_oi,
            diag: "Fórmula enviada desde Cotizador Web",
            doctor: "Pendiente Validación Optometrista"
          });
        }
      });

      // Registrar ingreso contable
      accountingData.unshift({
        date: today,
        type: "Ingreso",
        desc: `Pedido Web ${order.webOrderCode} - ${order.customer.name}`,
        method: "Por Confirmar / Transferencia",
        amount: order.totalUsd
      });

      // Registrar/actualizar cliente
      const existingCli = clientsData.find(c => c.name.toLowerCase() === order.customer.name.toLowerCase());
      if (existingCli) {
        existingCli.total += order.totalUsd;
      } else {
        clientsData.unshift({
          id: "CLI-0" + (clientsData.length + 1),
          name: order.customer.name,
          rif: order.customer.cedula,
          type: "Particular",
          contact: order.customer.phone,
          total: order.totalUsd
        });
      }

      order.status = "Facturado y Procesado";
      localStorage.setItem("optica_web_orders", JSON.stringify(webOrders));
      saveCatalog(catalog);
      saveAll();
      refreshAll();
      alert(`Pedido ${webOrderCode} aprobado: Stock actualizado, venta contabilizada y ficha generada.`);
    }

