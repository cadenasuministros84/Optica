      const qty = parseInt(document.getElementById("saleQty").value) || 1;
      const unitSale = parseFloat(document.getElementById("salePrice").value) || item.precio_usd;
      const totalSale = unitSale * qty;
      const totalCost = (item.costo_usd || 0) * qty;
      const orderId = "OT-" + (1001 + salesData.length);
      const today = new Date().toISOString().slice(0, 10);

      salesData.unshift({
        orderId,
        date: today,
        client,
        sku: item.sku,
        product: `${item.marca} - ${item.nombre}`,
        qty,
        saleUsd: totalSale,
        costUsd: totalCost,
        seller: document.getElementById("saleSeller").value,
        status: document.getElementById("saleStatus").value
      });

      item.stock = Math.max(0, item.stock - qty);
      saveCatalog(catalog);

      accountingData.unshift({
        date: today,
        type: "Ingreso",
        desc: `Venta ${orderId} - ${item.nombre} (x${qty})`,
        method: "Divisas Efectivo ($)",
        amount: totalSale
      });

      saveAll();
      refreshAll();
      alert(`Venta ${orderId} registrada y stock actualizado en la tienda.`);
    }

    function addAccountingEntry() {
      const type = document.getElementById("accType").value;
      const desc = document.getElementById("accDesc").value.trim();
      const method = document.getElementById("accMethod").value;
      const amount = parseFloat(document.getElementById("accAmount").value) || 0;
      if (!desc || amount <= 0) return;

      accountingData.unshift({ date: new Date().toISOString().slice(0, 10), type, desc, method, amount });
      document.getElementById("accDesc").value = "";
      document.getElementById("accAmount").value = "";
      saveAll();
      refreshAll();
    }

    function addPatientRecord() {
      const name = document.getElementById("patName").value.trim();
      const idDoc = document.getElementById("patId").value.trim();
      if (!name || !idDoc) return;

      const od = `SPH ${document.getElementById("pOdSph").value} / CYL ${document.getElementById("pOdCyl").value} x ${document.getElementById("pOdAxis").value} (ADD ${document.getElementById("pOdAdd").value})`;
      const oi = `SPH ${document.getElementById("pOiSph").value} / CYL ${document.getElementById("pOiCyl").value} x ${document.getElementById("pOiAxis").value} (ADD ${document.getElementById("pOiAdd").value})`;

      patientsData.unshift({
        hc: "HC-00" + (patientsData.length + 1),
        name,
        idDoc,
        age: document.getElementById("patAge").value || "N/A",
        od,
        oi,
        diag: document.getElementById("patDiag").value || "Evaluación Optométrica",
        doctor: document.getElementById("patDoctor").value
      });

      document.getElementById("patName").value = "";
      document.getElementById("patId").value = "";
      saveAll();
      refreshAll();
    }

    function addClient() {
      const name = document.getElementById("cliName").value.trim();
      if (!name) return;
      clientsData.unshift({
        id: "CLI-0" + (clientsData.length + 1),
        name,
        rif: document.getElementById("cliRif").value.trim() || "N/A",
        type: document.getElementById("cliType").value,
        contact: document.getElementById("cliContact").value || "N/A",
        total: 0
      });
      document.getElementById("cliName").value = "";
      saveAll();
      refreshAll();
    }

    function addStaff() {
      const name = document.getElementById("stfName").value.trim();
      if (!name) return;
      staffData.push({
        code: "EMP-0" + (staffData.length + 1),
        name,
        role: document.getElementById("stfRole").value,
        license: document.getElementById("stfLicense").value || "N/A",
        comm: document.getElementById("stfComm").value || "Estándar",
        status: "Activo"
      });
      document.getElementById("stfName").value = "";
      saveAll();
      refreshAll();
    }

    function saveAll() {
      localStorage.setItem("erp_sales", JSON.stringify(salesData));
      localStorage.setItem("erp_acc", JSON.stringify(accountingData));
      localStorage.setItem("erp_patients", JSON.stringify(patientsData));
      localStorage.setItem("erp_clients", JSON.stringify(clientsData));
      localStorage.setItem("erp_staff", JSON.stringify(staffData));
    }

    function refreshAll() {
      const rate = getRate();
      const catalog = getCatalog();
      const webOrders = JSON.parse(localStorage.getItem("optica_web_orders")) || [];
      const pendingWebCount = webOrders.filter(o => o.status === "Pendiente por Procesar").length;

      document.getElementById("webOrdersBadge").textContent = pendingWebCount;
      document.getElementById("kpiWebPending").textContent = pendingWebCount;

      // KPIs
      const totalSales = salesData.reduce((acc, s) => acc + s.saleUsd, 0);
      const totalCost = salesData.reduce((acc, s) => acc + s.costUsd, 0);
      const profit = totalSales - totalCost;
      const margin = totalSales > 0 ? ((profit / totalSales) * 100).toFixed(1) : 0;

      document.getElementById("kpiSalesUsd").textContent = `$${totalSales.toFixed(2)}`;
      document.getElementById("kpiSalesBs").textContent = `${(totalSales * rate).toFixed(2)} Bs.`;
      document.getElementById("kpiCostUsd").textContent = `$${totalCost.toFixed(2)}`;
      document.getElementById("kpiProfitUsd").textContent = `$${profit.toFixed(2)}`;
      document.getElementById("kpiMarginPct").textContent = `Margen Bruto: ${margin}%`;
      document.getElementById("kpiPatientsCount").textContent = `${patientsData.length} fichas clínicas activas`;

      // Pedidos Web
      document.getElementById("webOrdersTableBody").innerHTML = webOrders.length === 0
        ? `<tr><td colspan="8" style="text-align:center; color:var(--muted);">Aún no hay pedidos enviados desde index.html.</td></tr>`
        : webOrders.map(o => `
          <tr>
            <td><strong>${o.webOrderCode}</strong></td>
            <td>${o.date}</td>
            <td><strong>${o.customer.name}</strong><br/><small>${o.customer.phone} | ${o.customer.cedula}</small></td>
            <td>${o.customer.delivery}</td>
            <td>${o.items.map(i => `<div>• ${i.nombre} (x${i.qty})</div>`).join("")}</td>
            <td><strong>$${o.totalUsd.toFixed(2)}</strong></td>
            <td><span class="badge ${o.status === 'Pendiente por Procesar' ? 'badge-amber' : 'badge-green'}">${o.status}</span></td>
            <td>
              ${o.status === 'Pendiente por Procesar'
                ? `<button class="btn btn-success" onclick="approveWebOrder('${o.webOrderCode}')">✅ Aprobar y Facturar</button>`
                : `<span style="color:var(--muted); font-size:0.8rem;">Procesado</span>`}
            </td>
          </tr>
        `).join("");

      // Inventario
      document.getElementById("inventoryTableBody").innerHTML = catalog.map(c => `
        <tr>
          <td><code>${c.sku}</code></td>
          <td>${c.departamento}</td>
          <td><strong>${c.marca}</strong> - ${c.nombre}</td>
          <td>${c.genero} (${c.grupo_edad})</td>
          <td>$${(c.costo_usd || 0).toFixed(2)}</td>
          <td><strong>$${c.precio_usd.toFixed(2)}</strong></td>
          <td><span class="badge ${c.stock > 3 ? 'badge-green' : 'badge-red'}">${c.stock} unid.</span></td>
          <td>
            <button class="btn btn-outline" onclick="adjustStock('${c.sku}', -1)">-1</button>
            <button class="btn btn-outline" onclick="adjustStock('${c.sku}', 1)">+1</button>
          </td>
        </tr>
      `).join("");

      // Select de ventas rápidas
      const sel = document.getElementById("saleProductSelect");
      if (sel) {
        sel.innerHTML = catalog.map(c => `<option value="${c.sku}">${c.sku} - ${c.marca} ${c.nombre} ($${c.precio_usd})</option>`).join("");
        fillSalePriceFromCatalog();
      }

      // Contabilidad
      document.getElementById("accTableBody").innerHTML = accountingData.map(a => `
        <tr>
          <td>${a.date}</td>
          <td><span class="badge ${a.type === 'Ingreso' ? 'badge-green' : 'badge-red'}">${a.type}</span></td>
          <td>${a.desc}</td>
          <td>${a.method}</td>
          <td><strong>${a.type === 'Ingreso' ? '+' : '-'}$${a.amount.toFixed(2)}</strong></td>
          <td>${(a.amount * rate).toFixed(2)} Bs.</td>
        </tr>
      `).join("");

      // Ventas
      document.getElementById("salesTableBody").innerHTML = salesData.map(s => {
        const util = s.saleUsd - s.costUsd;
        return `
          <tr>
            <td><strong>${s.orderId}</strong></td>
            <td>${s.date}</td>
            <td>${s.client}</td>
            <td><code>${s.sku}</code></td>
            <td>${s.product}</td>
            <td>${s.qty}</td>
            <td><strong>$${s.saleUsd.toFixed(2)}</strong></td>
            <td>$${s.costUsd.toFixed(2)}</td>
            <td style="color: var(--success); font-weight:700;">+$${util.toFixed(2)}</td>
            <td>${s.seller}</td>
            <td><span class="badge ${s.status === 'Entregado' ? 'badge-green' : 'badge-amber'}">${s.status}</span></td>
          </tr>
        `;
      }).join("");

      // Pacientes
      document.getElementById("patientsTableBody").innerHTML = patientsData.map(p => `
        <tr>
          <td><strong>${p.hc}</strong></td>
          <td>${p.name}</td>
          <td>${p.idDoc}</td>
          <td>${p.age}</td>
          <td><code>${p.od}</code></td>
          <td><code>${p.oi}</code></td>
          <td>${p.diag}</td>
          <td>${p.doctor}</td>
        </tr>
      `).join("");

      // Clientes
      document.getElementById("clientsTableBody").innerHTML = clientsData.map(c => `
        <tr>
          <td><strong>${c.id}</strong></td>
          <td>${c.name}</td>
          <td>${c.rif}</td>
          <td><span class="badge badge-blue">${c.type}</span></td>
          <td>${c.contact}</td>
          <td><strong>$${c.total.toFixed(2)}</strong></td>
        </tr>
      `).join("");

      // Staff
      document.getElementById("staffTableBody").innerHTML = staffData.map(st => `
        <tr>
          <td><strong>${st.code}</strong></td>
          <td>${st.name}</td>
          <td>${st.role}</td>
          <td>${st.license}</td>
          <td>${st.comm}</td>
          <td><span class="badge badge-green">${st.status}</span></td>
        </tr>
      `).join("");
    }

    function exportTableCSV(tableId, filename) {
      const rows = document.querySelectorAll(`#${tableId} tr`);
      const csv = Array.from(rows).map(row => {
        const cols = row.querySelectorAll("th, td");
        return Array.from(cols).map(c => `"${c.innerText.replace(/"/g, '""')}"`).join(",");
      }).join("\n");
      const blob = new Blob([csv], { type: "text/csv;charset=utf-8;" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = filename;
      link.click();
    }

    function exportAllJSON() {
      const backup = {
        fecha_respaldo: new Date().toISOString(),
        tasa_bcv: getRate(),
        catalogo_productos: getCatalog(),
        pedidos_web: JSON.parse(localStorage.getItem("optica_web_orders")) || [],
        ventas: salesData,
        contabilidad: accountingData,
        pacientes: patientsData,
        clientes: clientsData,
        especialistas_empleados: staffData
      };
      const blob = new Blob([JSON.stringify(backup, null, 2)], { type: "application/json" });
      const link = document.createElement("a");
      link.href = URL.createObjectURL(blob);
      link.download = "Respaldo_Completo_Optica.json";
      link.click();
    }

    function importAllJSON(event) {
      const file = event.target.files[0];
      if (!file) return;
      const reader = new FileReader();
      reader.onload = function(e) {
        try {
          const data = JSON.parse(e.target.result);
          if (data.tasa_bcv) localStorage.setItem("optica_shared_rate", data.tasa_bcv.toString());
          if (data.catalogo_productos) saveCatalog(data.catalogo_productos);
          if (data.pedidos_web) localStorage.setItem("optica_web_orders", JSON.stringify(data.pedidos_web));
          if (data.ventas) salesData = data.ventas;
          if (data.contabilidad) accountingData = data.contabilidad;
          if (data.pacientes) patientsData = data.pacientes;
          if (data.clientes) clientsData = data.clientes;
          if (data.especialistas_empleados) staffData = data.especialistas_empleados;
          saveAll();
          initRate();
          refreshAll();
          alert("Base de datos restaurada exitosamente desde el archivo JSON.");
        } catch (err) {
          alert("Error al leer el archivo JSON de respaldo.");
        }
      };
      reader.readAsText(file);
    }

    window.addEventListener("storage", () => {
      initRate();
      refreshAll();
    });

    initRate();
    refreshAll();
  </script>
</body>
</html>
