      { sku: "LC-ACU-OAS-6", departamento: "Contactologia", subtipo: "Esférico", marca: "Johnson & Johnson", nombre: "Acuvue Oasys Hydraclear (Caja x6)", genero: "Unisex", grupo_edad: "Adultos", forma_aro: "N/A", tipo_montura: "N/A", material: "Hidrogel Silicona | BC 8.4/8.8", medidas: "DIA 14.0 mm | Quincenal", stock: 25, costo_usd: 24.00, precio_usd: 42.00, icon: "🔵" },
      { sku: "LC-AIR-TOR-6", departamento: "Contactologia", subtipo: "Tórico", marca: "Alcon", nombre: "Air Optix Astigmatismo (Caja x6)", genero: "Unisex", grupo_edad: "Adultos", forma_aro: "N/A", tipo_montura: "N/A", material: "Lotrafilcon B | BC 8.7", medidas: "DIA 14.5 mm | Mensual", stock: 15, costo_usd: 32.00, precio_usd: 55.00, icon: "🔵" },
      { sku: "ACC-KIT-LIMP-01", departamento: "Accesorios", subtipo: "Limpieza", marca: "Visión Care", nombre: "Kit Spray Limpiador AR + Paño Microfibra", genero: "Unisex", grupo_edad: "Adultos", forma_aro: "N/A", tipo_montura: "N/A", material: "60ml Sin Alcohol", medidas: "Universal", stock: 60, costo_usd: 2.50, precio_usd: 7.00, icon: "🧴" },
      { sku: "ACC-COR-DEP-03", departamento: "Accesorios", subtipo: "Sujetadores", marca: "Kids & Sport", nombre: "Cordón Sujetador Silicona Niños / Deporte", genero: "Infantil", grupo_edad: "Niños", forma_aro: "N/A", tipo_montura: "N/A", material: "Silicona Hipoalergénica", medidas: "Ajustable", stock: 35, costo_usd: 1.50, precio_usd: 5.00, icon: "🎗️" },
      { sku: "SRV-EXA-01", departamento: "Servicios", subtipo: "Consultorio", marca: "Optometría Clínica", nombre: "Consulta Optométrica Integral + Agudeza Visual", genero: "Unisex", grupo_edad: "Adultos", forma_aro: "N/A", tipo_montura: "N/A", material: "Duración: 30 min", medidas: "Gratis al comprar lentes", stock: 99, costo_usd: 0.00, precio_usd: 15.00, icon: "🩺" },
      { sku: "TAL-MON-01", departamento: "Servicios", subtipo: "Taller Óptico", marca: "Laboratorio", nombre: "Servicio de Biselado y Montaje Computarizado", genero: "Unisex", grupo_edad: "Adultos", forma_aro: "N/A", tipo_montura: "N/A", material: "Entrega 24h", medidas: "Aro Completo", stock: 99, costo_usd: 3.00, precio_usd: 10.00, icon: "⚙️" }
    ];

    function getCatalog() {
      const saved = localStorage.getItem("optica_shared_catalog");
      if (saved) return JSON.parse(saved);
      localStorage.setItem("optica_shared_catalog", JSON.stringify(DEFAULT_CATALOG));
      return DEFAULT_CATALOG;
    }

    let cart = JSON.parse(localStorage.getItem("optica_cart")) || [];

    function initRate() {
      const sharedRate = localStorage.getItem("optica_shared_rate");
      if (sharedRate) {
        document.getElementById("exchangeRate").value = parseFloat(sharedRate).toFixed(2);
      }
    }

    function syncRateFromStore() {
      const val = parseFloat(document.getElementById("exchangeRate").value) || 45.50;
      localStorage.setItem("optica_shared_rate", val.toString());
      renderProducts();
      renderCart();
    }

    function getRate() {
      return parseFloat(document.getElementById("exchangeRate").value) || 45.50;
    }

    function renderProducts() {
      const catalog = getCatalog();
      const grid = document.getElementById("productsGrid");
      const search = document.getElementById("searchInput").value.toLowerCase();
      const dept = document.getElementById("filterDept").value;
      const gender = document.getElementById("filterGender").value;
      const age = document.getElementById("filterAge").value;
      const brand = document.getElementById("filterBrand").value;
      const frameType = document.getElementById("filterFrameType").value;
      const rate = getRate();

      const filtered = catalog.filter(item => {
        const matchSearch =
          item.nombre.toLowerCase().includes(search) ||
          item.marca.toLowerCase().includes(search) ||
          item.sku.toLowerCase().includes(search) ||
          item.grupo_edad.toLowerCase().includes(search) ||
          item.subtipo.toLowerCase().includes(search);

        const matchDept = dept === "all" || item.departamento === dept;
        const matchGender = !gender || item.genero === gender;
        const matchAge = !age || item.grupo_edad === age;
        const matchBrand = !brand || item.marca.includes(brand);
        const matchFrame = !frameType || item.tipo_montura.includes(frameType);

        return matchSearch && matchDept && matchGender && matchAge && matchBrand && matchFrame;
      });

      document.getElementById("resultsCount").textContent = `${filtered.length} producto(s) encontrados`;

      grid.innerHTML = filtered.map(p => {
        const priceBs = (p.precio_usd * rate).toFixed(2);
        const outOfStock = p.stock <= 0;
        return `
          <div class="product-card">
            <div class="card-img">
              <span class="badge-dept">${p.departamento}</span>
              <span class="badge-age">${p.grupo_edad}</span>
              <div style="font-size: 3rem;">${p.icon || '👓'}</div>
              <small style="color: var(--muted); margin-top: 6px;">SKU: ${p.sku}</small>
            </div>
            <div class="card-body">
              <div class="card-brand">${p.marca} • ${p.genero}</div>
              <div class="card-title">${p.nombre}</div>
              <div class="card-specs">
                <div><strong>Tipo:</strong> ${p.subtipo} ${p.tipo_montura !== 'N/A' ? '(' + p.tipo_montura + ')' : ''}</div>
                <div><strong>Spec:</strong> ${p.material}</div>
                <div><strong>Medida:</strong> ${p.medidas} | <strong>Stock:</strong> ${p.stock}</div>
              </div>
              <div class="card-price-row">
                <span class="price-usd">$${p.precio_usd.toFixed(2)}</span>
                <span class="price-bs">${priceBs} Bs.</span>
              </div>
              <div class="card-actions">
                <button class="btn-add" ${outOfStock ? 'disabled' : ''} onclick="addToCart('${p.sku}')">
                  ${outOfStock ? 'Agotado' : '+ Agregar al Carrito'}
                </button>
                ${p.departamento === 'Monturas' ? `<a href="#cotizador-cristales" class="btn-rx" style="text-align:center; text-decoration:none;">+ Añadir Fórmula de Cristales</a>` : ''}
              </div>
            </div>
          </div>
        `;
      }).join("");
    }

    function quickFilter(dept, gender, age) {
      document.getElementById("filterDept").value = dept;
      document.getElementById("filterGender").value = gender;
      document.getElementById("filterAge").value = age;
      document.getElementById("filterBrand").value = "";
      document.getElementById("filterFrameType").value = "";
      renderProducts();
    }

    function filterByFrameType(type) {
      document.getElementById("filterDept").value = "Monturas";
      document.getElementById("filterFrameType").value = type;
      renderProducts();
    }

    function filterByBrand(brand) {
      document.getElementById("filterBrand").value = brand;
      renderProducts();
    }

    function filterBySubType(sub) {
      document.getElementById("searchInput").value = sub;
      renderProducts();
    }

    function setTab(btn, dept) {
      document.querySelectorAll(".tab-btn").forEach(b => b.classList.remove("active"));
      btn.classList.add("active");
      document.getElementById("filterDept").value = dept;
      renderProducts();
    }

    function resetFilters() {
      document.getElementById("searchInput").value = "";
      document.getElementById("filterDept").value = "all";
      document.getElementById("filterGender").value = "";
      document.getElementById("filterAge").value = "";
      document.getElementById("filterBrand").value = "";
      document.getElementById("filterFrameType").value = "";
      renderProducts();
    }

    function evaluateRx() {
      const odSph = Math.abs(parseFloat(document.getElementById("odSph").value) || 0);
      const oiSph = Math.abs(parseFloat(document.getElementById("oiSph").value) || 0);
      const maxSph = Math.max(odSph, oiSph);
      const add = Math.max(parseFloat(document.getElementById("odAdd").value) || 0, parseFloat(document.getElementById("oiAdd").value) || 0);

      let msg = "";
      if (add > 0) {
        msg = "💡 <strong>Adición detectada (Presbicia):</strong> Te recomendamos seleccionar <strong>Progresivo Digital Free-Form</strong> o <strong>Bifocal Flat-Top</strong>.";
      } else if (maxSph <= 2.00) {
        msg = "💡 <strong>Fórmula baja (0.00 a 2.00):</strong> El índice estándar <strong>1.50 (CR-39)</strong> o <strong>Policarbonato 1.59</strong> es ideal.";
      } else if (maxSph <= 4.00) {
        msg = "💡 <strong>Fórmula moderada (2.25 a 4.00):</strong> Recomendamos <strong>Policarbonato 1.59</strong> por ligereza y resistencia a impactos.";
      } else {
        msg = "💡 <strong>Fórmula alta (+4.25 o superior):</strong> Te sugerimos <strong>Alto Índice 1.67</strong> para reducir hasta un 35% el grosor del cristal.";
      }
      document.getElementById("rxAdvice").innerHTML = msg;
    }

    function addCustomRxToCart() {
      const designVal = document.getElementById("rxDesign").value.split("|");
      const extraVal = document.getElementById("rxExtra").value.split("|");
      const totalUsd = parseFloat(designVal[1]) + parseFloat(extraVal[1]);
      const totalCost = parseFloat(designVal[2]) + parseFloat(extraVal[2]);

      const od = `OD: SPH ${document.getElementById("odSph").value} / CYL ${document.getElementById("odCyl").value} x ${document.getElementById("odAxis").value}° (ADD ${document.getElementById("odAdd").value})`;
      const oi = `OI: SPH ${document.getElementById("oiSph").value} / CYL ${document.getElementById("oiCyl").value} x ${document.getElementById("oiAxis").value}° (ADD ${document.getElementById("oiAdd").value})`;
      const dip = `DIP: ${document.getElementById("rxDip").value}mm`;

      const customSku = "RX-" + Date.now().toString().slice(-5);
      cart.push({
        sku: customSku,
        nombre: `Cristales ${designVal[0]} (${extraVal[0]})`,
        detalle: `${od} | ${oi} | ${dip}`,
        rx_od: od,
        rx_oi: oi,
        precio_usd: totalUsd,
        costo_usd: totalCost,
        qty: 1
      });

      saveAndRenderCart();
      toggleCart(true);
    }

    function addToCart(sku) {
      const catalog = getCatalog();
      const prod = catalog.find(p => p.sku === sku);
      if (!prod || prod.stock <= 0) return;

      const existing = cart.find(c => c.sku === sku);
      if (existing) {
        existing.qty += 1;
      } else {
        cart.push({
          sku: prod.sku,
          nombre: `${prod.marca} - ${prod.nombre}`,
          detalle: `${prod.departamento} | ${prod.subtipo}`,
          precio_usd: prod.precio_usd,
          costo_usd: prod.costo_usd || 0,
          qty: 1
        });
      }
      saveAndRenderCart();
      toggleCart(true);
    }

    function updateQty(index, delta) {
      cart[index].qty += delta;
      if (cart[index].qty <= 0) cart.splice(index, 1);
      saveAndRenderCart();
    }

    function removeItem(index) {
      cart.splice(index, 1);
      saveAndRenderCart();
    }

    function clearCart() {
      if (cart.length === 0) return;
      if (confirm("¿Estás seguro de que deseas vaciar todos los productos del carrito?")) {
        cart = [];
        saveAndRenderCart();
      }
    }

    function saveAndRenderCart() {
      localStorage.setItem("optica_cart", JSON.stringify(cart));
      renderCart();
    }

    function renderCart() {
      const container = document.getElementById("cartItemsContainer");
      const rate = getRate();
      let totalUsd = 0;
      let totalItems = 0;

      if (cart.length === 0) {
        container.innerHTML = `<p style="text-align:center; color: var(--muted); margin-top: 40px;">Tu carrito está vacío. Selecciona monturas, cristales o servicios del catálogo.</p>`;
      } else {
        container.innerHTML = cart.map((item, idx) => {
          const subtotal = item.precio_usd * item.qty;
          totalUsd += subtotal;
          totalItems += item.qty;
          return `
            <div class="cart-item">
              <div class="cart-item-info">
                <h5>${item.nombre}</h5>
                <p>SKU: ${item.sku}</p>
                <p>${item.detalle}</p>
                <div class="qty-controls">
                  <button class="qty-btn" onclick="updateQty(${idx}, -1)">-</button>
                  <span>${item.qty}</span>
                  <button class="qty-btn" onclick="updateQty(${idx}, 1)">+</button>
                  <button class="btn-remove-item" onclick="removeItem(${idx})">Eliminar</button>
                </div>
              </div>
              <div style="text-align: right;">
                <strong>$${subtotal.toFixed(2)}</strong><br/>
                <small style="color: var(--muted);">${(subtotal * rate).toFixed(2)} Bs.</small>
              </div>
            </div>
          `;
        }).join("");
      }

      document.getElementById("cartCount").textContent = totalItems;
      document.getElementById("cartTotalUsd").textContent = `$${totalUsd.toFixed(2)}`;
      document.getElementById("cartTotalBs").textContent = `${(totalUsd * rate).toFixed(2)} Bs.`;
      const clearBtn = document.getElementById("btnClearCart");
      if (clearBtn) clearBtn.style.display = cart.length > 0 ? "block" : "none";
    }

    function toggleCart(open) {
      const drawer = document.getElementById("cartDrawer");
      const overlay = document.getElementById("cartOverlay");
      drawer.classList.toggle("open", open);
      overlay.style.display = open ? "block" : "none";
    }

    // =========================================================================
    // ENVÍO A WHATSAPP + REGISTRO AUTOMÁTICO EN COLA DEL ERP ADMINISTRATIVO
    // =========================================================================
    function sendWhatsAppReport() {
      if (cart.length === 0) {
        alert("Agrega al menos un producto o servicio al carrito antes de enviar el reporte.");
        return;
      }

      const custName = document.getElementById("custName").value.trim() || "Cliente Web";
      const custPhone = document.getElementById("custPhone").value.trim() || "No indicado";
      const custCedula = document.getElementById("custCedula").value.trim() || "N/A";
      const custDelivery = document.getElementById("custDelivery").value;
      const rate = getRate();
      const webOrderCode = "WEB-" + Date.now().toString().slice(-6);

      let totalUsd = 0;
      cart.forEach(item => totalUsd += item.precio_usd * item.qty);

      // Guardar pedido en la cola compartida 'optica_web_orders' para admin_optica.html
      const webOrders = JSON.parse(localStorage.getItem("optica_web_orders")) || [];
      webOrders.unshift({
        webOrderCode,
        date: new Date().toISOString().slice(0, 10),
        customer: { name: custName, phone: custPhone, cedula: custCedula, delivery: custDelivery },
        items: JSON.parse(JSON.stringify(cart)),
        totalUsd,
        rate,
        status: "Pendiente por Procesar"
      });
      localStorage.setItem("optica_web_orders", JSON.stringify(webOrders));

      let lines = [
        `👓 *PEDIDO WEB #${webOrderCode} - ÓPTICA VISIÓN HD*`,
        "----------------------------------------",
        `👤 *Cliente:* ${custName}`,
        `🪪 *Cédula/RIF:* ${custCedula}`,
        `📞 *Teléfono:* ${custPhone}`,
        `🚚 *Modalidad:* ${custDelivery}`,
        `💱 *Tasa Ref.:* ${rate.toFixed(2)} Bs./USD`,
        "----------------------------------------",
        "*DETALLE DE PRODUCTOS SELECCIONADOS:*"
      ];

      cart.forEach((item, i) => {
        const sub = item.precio_usd * item.qty;
        lines.push(`${i + 1}. *${item.nombre}* (x${item.qty})`);
        lines.push(`   • SKU: ${item.sku}`);
        lines.push(`   • Detalle: ${item.detalle}`);
        lines.push(`   • Subtotal: $${sub.toFixed(2)} (${(sub * rate).toFixed(2)} Bs.)`);
      });

      lines.push("----------------------------------------");
      lines.push(`💰 *TOTAL USD:* $${totalUsd.toFixed(2)}`);
      lines.push(`💵 *TOTAL BS.:* ${(totalUsd * rate).toFixed(2)} Bs.`);
      lines.push("----------------------------------------");
      lines.push("Pedido registrado en sistema. Por favor confirmar disponibilidad.");

      const encodedText = encodeURIComponent(lines.join("\n"));
      const targetNumber = EMPRESA_WHATSAPP.replace(/\D/g, "");
      const waUrl = targetNumber
        ? `https://wa.me/${targetNumber}?text=${encodedText}`
        : `https://api.whatsapp.com/send?text=${encodedText}`;

      window.open(waUrl, "_blank");
    }

    // Escuchar cambios hechos desde admin_optica.html en tiempo real
    window.addEventListener("storage", () => {
      initRate();
      renderProducts();
      renderCart();
    });

    initRate();
    renderProducts();
    renderCart();
  </script>
