      { sku: "CRI-MONO-POLY-BC", departamento: "Cristales", subtipo: "Monofocal", marca: "Laboratorio Óptico", nombre: "Par Policarbonato + Filtro Luz Azul", genero: "Unisex", grupo_edad: "Jóvenes", forma_aro: "N/A", tipo_montura: "N/A", material: "Policarbonato 1.59 Irrompible", medidas: "Blanco 70/75 mm", stock: 30, costo_usd: 24.00, precio_usd: 65.00, icon: "💻" },
